# Everything the extension does not need at runtime. dist/extension.js is the
# whole bundle, so src/ and the toolchain that built it stay out of the .vsix.
.vscode/**
.claude/**
# Multi-agent working agreements and live session status. Neither is runtime
# content, and a session's status file was found inside the 0.0.7 package before
# this line existed, which would have shipped it to every user.
AGENTS.md
.agents/**
.gitignore
.vscodeignore

src/**
tsconfig.json
package-lock.json

# Scratch tooling that happens to live in the working tree. Nothing here is part
# of the extension, and a .bat launching a PowerShell script under
# -ExecutionPolicy Bypass is the last thing a published .vsix should contain:
# it ships to every user and it is exactly the shape a malware scanner flags.
boost-fps/**

docs/plan.md
# The demo clip is documentation on GitHub, not runtime content, so it stays out
# of the .vsix. vsce rewrites relative image paths in the README to raw GitHub
# URLs, so the marketplace page still shows it.
#
# Needs the leading **, or it only matches the repo root: a plain *.gif left the
# 19MB docs/demo.gif in the package, which was 87% of it.
docs/demo.mp4
**/*.gif

# Reference art the icons were drawn from. Never loaded at runtime.
knight-helm.jpg

# Superseded by the pack's own tilemap — see the note above SCENE_FILES in
# src/extension.ts.
media/scene/**

# Only the two factions the colour setting can select are loaded, plus the Red
# warrior for the raiders; the rest of the pack is unreferenced weight. The
# aseprite sources are authoring files and never load in a webview at all.
**/*.aseprite
media/tiny-swords/Units/Purple Units/**
media/tiny-swords/Units/Yellow Units/**
media/tiny-swords/Units/Units (aseprite in Blue only)/**
media/tiny-swords/Units/Red Units/Monk/**
media/tiny-swords/Units/Red Units/Archer/**
media/tiny-swords/Units/Red Units/Lancer/**
media/tiny-swords/Units/Red Units/Pawn/**
# Except the two Red Pawn sheets that warnings use: they only stand and walk.
!media/tiny-swords/Units/Red Units/Pawn/Pawn_Idle.png
!media/tiny-swords/Units/Red Units/Pawn/Pawn_Run.png
media/tiny-swords/Buildings/Purple Buildings/**
media/tiny-swords/Buildings/Yellow Buildings/**
media/tiny-swords/Buildings/Red Buildings/**
# Wood is the island's only resource, so no gold, no meat, and none of the
# pawn sheets for carrying or working them. The Sheep's own sheets stay.
media/tiny-swords/Terrain/Resources/Gold/**
media/tiny-swords/Terrain/Resources/Meat/Meat Resource/**
media/tiny-swords/Terrain/Resources/Tools/Tool_04.png
media/tiny-swords/Units/*/Pawn/*Gold.png
media/tiny-swords/Units/*/Pawn/*Meat.png
media/tiny-swords/Units/*/Pawn/*Pickaxe.png
media/tiny-swords/Units/*/Pawn/*Knife.png
media/tiny-swords/UI Elements/**
# Except the few pieces the activity HUD is dressed in (UI_FILES in src/sprites.ts).
!media/tiny-swords/UI Elements/UI Elements/Papers/SpecialPaper.png
!media/tiny-swords/UI Elements/UI Elements/Icons/Icon_02.png
!media/tiny-swords/UI Elements/UI Elements/Icons/Icon_05.png
!media/tiny-swords/UI Elements/UI Elements/Icons/Icon_06.png
!media/tiny-swords/UI Elements/UI Elements/Icons/Icon_08.png
