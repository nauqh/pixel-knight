{
  "name": "pixel-knights",
  "displayName": "Pixel Knights",
  "description": "A garrisoned pixel island in your sidebar. Errors land raiders on the shore; fix them and the knights cut them down.",
  "version": "0.0.6",
  "publisher": "nauqh",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/logo.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/nauqh/pixel-knight.git"
  },
  "bugs": {
    "url": "https://github.com/nauqh/pixel-knight/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pixel",
    "pet",
    "companion",
    "sidebar",
    "pixel art"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pixelKnight",
          "title": "Pixel Knights",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "pixelKnight": [
        {
          "type": "webview",
          "id": "pixelKnight.view",
          "name": "Pixel Knights"
        }
      ]
    },
    "commands": [
      {
        "command": "pixelKnight.open",
        "title": "Pixel Knights: Focus Companion View"
      }
    ],
    "configuration": {
      "title": "Pixel Knights",
      "properties": {
        "pixelKnight.colour": {
          "type": "string",
          "enum": [
            "colour1",
            "colour2"
          ],
          "enumDescriptions": [
            "Blue",
            "Black"
          ],
          "default": "colour1",
          "description": "Faction palette for the knight, the garrison and the buildings. Raiders stay red either way."
        }
      }
    }
  },
  "activationEvents": [],
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --external:vscode --outfile=dist/extension.js --watch",
    "package": "npm version patch --no-git-tag-version && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0"
  }
}
